ClientOnly 1
RunAsDaemon 0
DataDirectory /var/lib/tor
# This directory is tmpfs. Flush guard changes there promptly; the host saves
# only the selected operational state in the encrypted profile.
AvoidDiskWrites 0
SafeLogging 1
Log err stderr
SocksPort 127.0.0.1:9050 IsolateSOCKSAuth IPv4Traffic NoIPv6Traffic
SocksPolicy accept 127.0.0.1/32
SocksPolicy reject *
ClientRejectInternalAddresses 1
ClientDNSRejectInternalAddresses 1
ClientUseIPv6 0
ClientPreferIPv6ORPort 0
ControlSocket /run/tor/control
ControlSocketsGroupWritable 0
CookieAuthentication 1
CookieAuthFile /run/tor/control.authcookie
# The host controller must supply the saved infrastructure state before enabling
# networking. This image must not silently discard guards on each live boot.
DisableNetwork 1
