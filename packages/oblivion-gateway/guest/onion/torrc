# Dedicated transfer Tor instance; no model broker or SOCKS listener.
ClientOnly 1
RunAsDaemon 0
DataDirectory /var/lib/tor
AvoidDiskWrites 0
SafeLogging 1
Log err stderr
SocksPort 0
ClientRejectInternalAddresses 1
ClientDNSRejectInternalAddresses 1
ClientUseIPv6 0
ClientPreferIPv6ORPort 0
ControlSocket /run/tor/control
ControlSocketsGroupWritable 0
CookieAuthentication 1
CookieAuthFile /run/tor/control.authcookie
# Infrastructure guards are restored in RAM before the controller enables Tor.
DisableNetwork 1
