[Unit]
Description=Oblivion session-local OpenCode server
ConditionKernelCommandLine=!oblivion.documents=1
ConditionKernelCommandLine=!oblivion.resize=1
Requires=oblivion-vault.service oblivion-session-network.service
After=oblivion-vault.service oblivion-session-network.service

[Service]
Type=simple
User=1000
Group=1000
WorkingDirectory=/vault/workspace
RuntimeDirectory=oblivion-chat
RuntimeDirectoryMode=0700
Environment=HOME=/vault/home
Environment=XDG_CONFIG_HOME=/vault/config
Environment=XDG_STATE_HOME=/vault/state
Environment=XDG_DATA_HOME=/vault/state
Environment=XDG_CACHE_HOME=/tmp/oblivion-cache
Environment=TMPDIR=/tmp
ExecStartPre=/usr/bin/python3 -c 'import secrets; from pathlib import Path; Path("/run/oblivion-chat/password").write_text(secrets.token_urlsafe(32))'
ExecStart=/usr/lib/oblivion/guest/chat-server.sh
StandardOutput=null
StandardError=null
UMask=0077
# Agent shell tools have the same guest-only sudo rights as Workspace.
NoNewPrivileges=no
LimitCORE=0
KillMode=control-group
TimeoutStopSec=10s
Restart=no

[Install]
WantedBy=multi-user.target
