[Unit]
Description=Safe-local native agent history catalog
ConditionKernelCommandLine=oblivion.native=1
ConditionKernelCommandLine=!oblivion.resize=1
Requires=oblivion-vault.service
After=oblivion-vault.service
RequiresMountsFor=/vault

[Service]
Type=notify
NotifyAccess=main
User=1000
Group=1000
WorkingDirectory=/vault/workspace
RuntimeDirectory=oblivion-history
RuntimeDirectoryMode=0700
Environment=HOME=/vault/home
Environment=XDG_CONFIG_HOME=/vault/config
Environment=XDG_STATE_HOME=/vault/state
Environment=XDG_DATA_HOME=/vault/state
Environment=XDG_CACHE_HOME=/tmp/oblivion-cache
Environment=TMPDIR=/tmp
# Native index/import helpers must bypass the interactive history wrappers.
Environment=PATH=/usr/lib/oblivion/agents/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OTEL_SDK_DISABLED=true
ExecStart=/usr/bin/python3 -B /usr/lib/oblivion/history/history.py watch --home /vault/home --workspace /vault/workspace --state /vault/home/.oblivion-history --sync-socket /run/oblivion-history/sync.sock --admin-socket /run/oblivion-history/admin.sock --interval 2
UMask=0077
LimitCORE=0
MemorySwapMax=0
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateNetwork=yes
# The official OpenCode importer uses its own loopback HTTP server. The private
# namespace has no uplink, and this policy permits only that local traffic.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/vault/home /vault/config /vault/state /tmp/oblivion-cache
ReadOnlyPaths=/vault/workspace /vault/imports
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KillMode=control-group
TimeoutStartSec=15
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
StandardInput=null
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
