[Unit]
Description=Stream explicitly selected files into or out of a Safe
Requires=oblivion-vault.service
After=oblivion-vault.service
BindsTo=dev-%i.device

[Service]
Type=exec
User=1000
Group=1000
ExecStart=/usr/bin/python3 -B /usr/lib/oblivion/guest/file-channel.py /dev/%I
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
# Staging and publication must retain one mount for atomic rename. The endpoint
# fixes import to workspace and export to a selected workspace/imports root.
ReadWritePaths=/vault
LimitCORE=0
MemorySwapMax=0
MemoryMax=128M
TasksMax=8
RuntimeMaxSec=3700
TimeoutStopSec=5
KillMode=control-group
Restart=no
StandardInput=null
StandardOutput=null
StandardError=null
