[Unit]
Description=Bounded Safe administration without an agent process
Requires=oblivion-vault.service
After=oblivion-vault.service dev-virtio\x2dports-%i.device
BindsTo=dev-virtio\x2dports-%i.device

[Service]
Type=exec
User=1000
Group=1000
ExecStart=/usr/bin/python3 -B /usr/lib/oblivion/guest/safe-admin.py /dev/virtio-ports/%I
ExecStopPost=/usr/bin/python3 -B /usr/lib/oblivion/guest/safe-admin.py --cleanup %I
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ReadWritePaths=/vault/state /vault/workspace /vault/home/.oblivion-history
ProtectHome=yes
LimitCORE=0
MemorySwapMax=0
MemoryMax=128M
TasksMax=4
RuntimeMaxSec=60
TimeoutStopSec=5
KillMode=control-group
Restart=no
StandardInput=null
StandardOutput=null
StandardError=null
