[Unit]
Description=Safe-local native conversation admission
ConditionKernelCommandLine=oblivion.native=1
ConditionKernelCommandLine=!oblivion.resize=1
ConditionKernelCommandLine=!oblivion.share=1
Requires=oblivion-vault.service
After=oblivion-vault.service
RequiresMountsFor=/vault

[Service]
Type=notify
NotifyAccess=main
User=1000
Group=1000
WorkingDirectory=/vault/workspace
RuntimeDirectory=oblivion-author
RuntimeDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /usr/lib/oblivion/history/history.py author --home /vault/home --workspace /vault/workspace --state /vault/home/.oblivion-history --author-socket /run/oblivion-author/author.sock
UMask=0077
LimitCORE=0
MemorySwapMax=0
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/vault/home/.oblivion-history
ReadOnlyPaths=/vault/workspace /vault/imports
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KillMode=control-group
TimeoutStartSec=15
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
StandardInput=null
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
