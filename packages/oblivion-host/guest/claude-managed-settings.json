{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B /usr/lib/oblivion/history/history.py author-hook --author-socket /run/oblivion-author/author.sock",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
