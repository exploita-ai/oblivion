[Unit]
Description=Oblivion verified storage recovery
After=oblivion-controller.service
# Recovery is a controller lifecycle action. Restarting an interface must not
# stop Safe VMs owned by other attached clients.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/oblivion-storage --config /etc/oblivion/controller.json recover
TimeoutStartSec=90
UMask=0077
LimitCORE=0
MemorySwapMax=0
StandardInput=null
StandardOutput=null
StandardError=null
