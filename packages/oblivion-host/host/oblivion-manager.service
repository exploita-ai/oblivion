[Unit]
Description=Oblivion trusted console
BindsTo=oblivion-controller.service
Wants=oblivion-recover.service
After=oblivion-controller.service oblivion-recover.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=1000
Group=1000
ExecStart=/usr/bin/oblivion-manager
# Queue cleanup without waiting inside a unit ordered after that cleanup.
# The next start waits for recovery; a failure is shown by the recovery latch.
ExecStopPost=+/usr/bin/systemctl --no-block start oblivion-recover.service
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=10
UMask=0077
RuntimeDirectory=oblivion-manager
RuntimeDirectoryMode=0700
Environment=HOME=/run/oblivion-manager TERM=linux
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8
# Native code ships read-only with the OS; temporary data remains in private RAM.
Environment=OTUI_ASSET_ROOT=/usr/lib/oblivion/manager
Environment=TMPDIR=/run/oblivion-manager BUN_TMPDIR=/run/oblivion-manager
StandardInput=tty-force
StandardOutput=tty
StandardError=null
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
MemorySwapMax=0
