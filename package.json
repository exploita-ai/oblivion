{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oblivion",
  "description": "A privacy-focused live environment for the OpenCode coding agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd packages/cli src/index.ts",
    "dev:live": "sh -c 'OPENCODE_TUI_CHANNEL=dev OPENCODE_PASSWORD=\"$(opencode service get password)\" exec bun run dev \"$@\" --server \"$(opencode service status)\"' --",
    "build:iso": "sh script/oblivion/build-live.sh",
    "build:hardware": "sh script/oblivion/build-hardware.sh",
    "lint": "oxlint",
    "lint:effect-patterns": "ast-grep scan -c script/ast-grep/sgconfig.yml packages/util/src packages/core/src packages/server/src packages/protocol/src packages/cli/src",
    "lint:effect-simplifications": "ast-grep scan -c script/ast-grep/effect-simplifications/sgconfig.yml --off=unused-suppression packages",
    "test:lint-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "test:effect-simplification-rules": "ast-grep test -c script/ast-grep/effect-simplifications/sgconfig.yml",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.1",
      "@effect/platform-node": "4.0.1",
      "@effect/platform-node-shared": "4.0.1",
      "@effect/sql-sqlite-bun": "4.0.1",
      "@lydell/node-pty": "1.2.0-beta.12",
      "@npmcli/arborist": "9.4.0",
      "@opentui/core": "0.6.8",
      "@opentui/keymap": "0.6.8",
      "@opentui/solid": "0.6.8",
      "@standard-schema/spec": "1.1.0",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.4.3",
      "@types/cross-spawn": "6.0.6",
      "@types/mime-types": "3.0.1",
      "@types/node": "24.12.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "cross-spawn": "7.0.6",
      "diff": "8.0.4",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.0.1",
      "fast-check": "4.9.0",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "remeda": "2.26.0",
      "solid-js": "1.9.15",
      "string-width": "7.2.0",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "vite": "7.3.6",
      "vite-plugin-solid": "2.11.10",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.0",
    "@oxlint/plugins": "1.60.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exploita-ai/oblivion"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.4",
    "effect": "catalog:",
    "open": "11.0.4",
    "solid-js": "catalog:"
  },
  "patchedDependencies": {
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "solid-js@1.9.15": "patches/solid-js@1.9.15.patch",
    "pacote@21.5.1": "patches/pacote@21.5.1.patch",
    "@ff-labs/fff-bun@0.10.5": "patches/@ff-labs%2Ffff-bun@0.10.5.patch",
    "@modelcontextprotocol/client@2.3.1": "patches/@modelcontextprotocol%2Fclient@2.3.1.patch"
  }
}
