{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oblivion",
  "description": "A privacy layer for coding agents with isolated encrypted Safes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd packages/oblivion-manager dev",
    "build:iso": "sh script/oblivion/build-stack.sh",
    "vm:disk": "python3 script/oblivion/prepare-vm-disk.py",
    "lint": "oxlint packages/oblivion-manager packages/oblivion-tools packages/theme packages/tui-kit script/upgrade-opentui.ts",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/oblivion-manager",
      "packages/oblivion-tools",
      "packages/theme",
      "packages/tui-kit"
    ],
    "catalog": {
      "@opentui/core": "0.6.8",
      "@opentui/solid": "0.6.8",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.4.3",
      "@types/node": "24.12.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "effect": "4.0.1",
      "solid-js": "1.9.15",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exploita-ai/oblivion"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.4",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "patchedDependencies": {
    "solid-js@1.9.15": "patches/solid-js@1.9.15.patch",
    "@modelcontextprotocol/client@2.3.1": "patches/@modelcontextprotocol%2Fclient@2.3.1.patch"
  }
}
