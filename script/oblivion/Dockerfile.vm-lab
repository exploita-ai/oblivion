FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS stream-tls-fixture
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* && mkdir /fixture \
    && openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 7 \
        -subj '/CN=Oblivion laboratory root' \
        -addext 'basicConstraints=critical,CA:TRUE' \
        -addext 'keyUsage=critical,keyCertSign,cRLSign' \
        -keyout /fixture/ca-key.pem -out /fixture/ca.pem \
    && openssl req -newkey rsa:2048 -nodes -sha256 \
        -subj '/CN=api.abliteration.ai' \
        -keyout /fixture/key.pem -out /fixture/server.csr \
    && printf '%s\n' \
        'subjectAltName=DNS:api.abliteration.ai' \
        'basicConstraints=critical,CA:FALSE' \
        'keyUsage=critical,digitalSignature,keyEncipherment' \
        'extendedKeyUsage=serverAuth' > /fixture/server.ext \
    && openssl x509 -req -sha256 -days 7 -in /fixture/server.csr \
        -CA /fixture/ca.pem -CAkey /fixture/ca-key.pem -CAcreateserial \
        -extfile /fixture/server.ext -out /fixture/cert.pem \
    && rm /fixture/ca-key.pem /fixture/ca.srl /fixture/server.csr /fixture/server.ext \
    && chmod 0600 /fixture/key.pem

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS cage-build
COPY script/oblivion/display/build-cage.sh script/oblivion/display/patch-cage.py /build-cage/
RUN DEBIAN_FRONTEND=noninteractive sh /build-cage/build-cage.sh

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS os
ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd-sysv udev dbus util-linux e2fsprogs ca-certificates busybox-static \
    initramfs-tools kmod linux-image-${TARGETARCH} && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/vm-common-setup.sh /tmp/setup
COPY script/oblivion/journald-forwarding.conf /etc/systemd/journald.conf.d/90-oblivion-forwarding.conf
RUN sh /tmp/setup && rm /tmp/setup

# Only OS layers that run nested guests need ARM EL2 support. Other roles keep
# Debian stable. Desktop and Live share this exact controller kernel selection.
FROM os AS nested-hypervisor-os
ARG TARGETARCH
ARG OBLIVION_HOST_KERNEL_VERSION=""
COPY script/oblivion/hypervisor-kernel.py /tmp/hypervisor-kernel.py
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && python3 -B /tmp/hypervisor-kernel.py install "$TARGETARCH" --version "$OBLIVION_HOST_KERNEL_VERSION" \
    && rm /tmp/hypervisor-kernel.py && rm -rf /var/lib/apt/lists/*

FROM os AS rust-toolchain
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends rustup git gcc g++ libc6-dev cmake make perl libclang-dev python3 \
    && rm -rf /var/lib/apt/lists/* \
    && rustup toolchain install 1.88.0 --profile minimal --no-self-update \
    && rustup default 1.88.0 \
    && rustc --version && cargo --version

FROM rust-toolchain AS clipboard-compiler
WORKDIR /clipboard
COPY packages/oblivion-clipboard/ ./
RUN cargo fetch --locked
RUN --network=none cargo test --locked --offline && cargo build --locked --offline --release \
    && find Cargo.toml Cargo.lock src LICENSE PROVENANCE.md upstream.json -type f -print0 | sort -z | xargs -0 sha256sum > sources.sha256

FROM os AS clipboard-broker
RUN apt-get update && apt-get install -y --no-install-recommends libpciaccess0 libglib2.0-0t64 \
    && cd /tmp && apt-get download spice-vdagent \
    && mkdir /out && dpkg-deb -x spice-vdagent*.deb /out \
    && dpkg-deb --field spice-vdagent*.deb > /out/package.control \
    && sha256sum spice-vdagent*.deb /out/usr/sbin/spice-vdagentd > /out/SHA256SUMS \
    && ldd /out/usr/sbin/spice-vdagentd | tee /out/libraries.txt \
    && ! ldd /out/usr/sbin/spice-vdagentd | grep -q 'not found' \
    && /out/usr/sbin/spice-vdagentd --help >/out/help.txt \
    && rm -rf /var/lib/apt/lists/* /tmp/*.deb

FROM os AS clipboard-test
RUN apt-get update && apt-get install -y --no-install-recommends libwlroots-0.18 wl-clipboard python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1104 oblivion-display \
    && useradd --uid 1104 --gid 1104 --no-create-home oblivion-display
COPY --from=cage-build /out/oblivion-cage /usr/bin/
COPY --from=clipboard-compiler /clipboard/target/release/oblivion-clipboard /usr/bin/
COPY script/oblivion/test-vm-clipboard.py /usr/lib/oblivion/test-vm-clipboard.py
USER 1104:1104
ENV XDG_RUNTIME_DIR=/run/oblivion-display WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1
ENTRYPOINT ["/usr/bin/oblivion-cage", "-d", "--", "/usr/bin/python3", "-B", "/usr/lib/oblivion/test-vm-clipboard.py"]

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS vbox-clipboard
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates xorriso bzip2 \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/install-vbox-clipboard.py script/oblivion/vbox-clipboard.json /build/
RUN python3 -B /build/install-vbox-clipboard.py "$TARGETARCH" /out

FROM rust-toolchain AS compiler
WORKDIR /build
COPY packages/oblivion-cli/ /oblivion-cli/
COPY packages/oblivion-bundle/ /oblivion-bundle/
COPY packages/oblivion-native-windows/ /oblivion-native-windows/
COPY packages/oblivion-wire/ /oblivion-wire/
COPY packages/oblivion-tor-state/ /oblivion-tor-state/
COPY packages/oblivion-transport/ /oblivion-transport/
COPY packages/oblivion-transfer/ /oblivion-transfer/
COPY packages/oblivion-share/ /oblivion-share/
COPY packages/oblivion-history/ /oblivion-history/
COPY packages/oblivion-host/ ./
COPY packages/oblivion-tools/dist/server.mjs /oblivion-tools/dist/server.mjs
COPY packages/oblivion-gateway/ /oblivion-gateway/
COPY packages/oblivion-onion/ /oblivion-onion/
COPY packages/oblivion-clipboard/ /oblivion-clipboard/
COPY packages/oblivion-manager/src/ /oblivion-manager/src/
COPY packages/oblivion-manager/script/build.ts /oblivion-manager/script/build.ts
COPY packages/oblivion-manager/package.json /oblivion-manager/package.json
COPY packages/theme/src/ /theme/src/
COPY packages/tui-kit/src/ /tui-kit/src/
COPY package.json bun.lock LICENSE NOTICE /workspace-inputs/
COPY script/oblivion/Dockerfile.vm-lab script/oblivion/hypervisor-kernel.py script/oblivion/hypervisor-qemu.py script/oblivion/controller-setup.sh script/oblivion/controller-pack.sh script/oblivion/live-setup.sh script/oblivion/live-pack.sh script/oblivion/live-storage.py script/oblivion/live-media.py script/oblivion/live-grub.cfg script/oblivion/live-controller.json script/oblivion/vm-common-setup.sh script/oblivion/journald-forwarding.conf script/oblivion/session-identities.sh script/oblivion/pack-vm-assets.sh script/oblivion/host-firewall.nft script/oblivion/install-agents.py script/oblivion/install-agents.json script/oblivion/session-node.json script/oblivion/install-session-node.py script/oblivion/session-packages.txt script/oblivion/session-analysis.lock script/oblivion/session-analysis-licenses.json script/oblivion/install-session-analysis.py script/oblivion/onionshare-source.json script/oblivion/onionshare-requirements.lock script/oblivion/onionshare-licenses.json script/oblivion/install-onionshare.py script/oblivion/install-vbox-clipboard.py script/oblivion/vbox-clipboard.json /runtime-inputs/
COPY script/oblivion/display/ /runtime-inputs/display/
COPY script/oblivion/agent-notices/ /runtime-inputs/agent-notices/
COPY script/oblivion/live-os/ /runtime-inputs/live-os/
COPY script/oblivion/native-bundle/host-sources.py /runtime-inputs/native-bundle/host-sources.py
COPY script/oblivion/native-bundle/host-sources.py /host-sources.py
RUN cargo test --locked && cargo build --locked --release --bins --examples && cp target/release/oblivion-storage /tmp/oblivion-storage \
    && cargo build --locked --release --features lab-emulation --bin oblivion-storage
RUN cd /oblivion-transfer && cargo test --locked && cargo build --locked --release --bins
RUN mkdir /bundle && cp /oblivion-transfer/target/release/oblivion-copy /oblivion-transfer/target/release/oblivion-onion-file /bundle/ && cp /tmp/oblivion-storage /bundle/oblivion-storage \
    && cp target/release/oblivion-storage /bundle/oblivion-storage-lab \
    && cp target/release/oblivion target/release/oblivion-control target/release/oblivion-display /bundle/ \
    && cp host/*.service /bundle/ \
    && python3 -B /host-sources.py /build --scripts /runtime-inputs --workspace /workspace-inputs > /bundle/sources.sha256 \
    && cd /bundle && sha256sum oblivion-* sources.sha256 > SHA256SUMS

# Small development bundle, overlaid only in the disposable laboratory's RAM.
# It avoids rebuilding both Debian filesystems for each controller change.
FROM scratch AS host-artifacts
COPY --from=compiler /bundle/ /

# Dedicated endpoint proof. No production USB service is installed by this stage.
FROM os AS transfer-guest
ARG COPY_BINARY=artifacts/oblivion-transfer-endpoints/linux-arm64/oblivion-copy
RUN apt-get update && apt-get install -y --no-install-recommends python3 cryptsetup-bin \
    && rm -rf /var/lib/apt/lists/* && mkdir /source /destination
COPY ${COPY_BINARY} /usr/bin/oblivion-copy
COPY script/oblivion/vm-transfer-guest.py script/oblivion/transfer_fixture.py /usr/lib/oblivion-copy-lab/
COPY script/oblivion/vm-transfer.service /etc/systemd/system/
RUN systemctl enable vm-transfer.service

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS transfer-pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools e2fsprogs python3 \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/vm-transfer-guest.py script/oblivion/transfer_fixture.py script/oblivion/vm-transfer.service /sources/
RUN --mount=type=bind,from=transfer-guest,source=/,target=/guest,ro \
    mkdir /out /fixture && python3 /sources/transfer_fixture.py /fixture \
    && truncate -s 32M /out/source.raw && mkfs.ext4 -q -m 0 -d /fixture /out/source.raw \
    && cp /guest/boot/vmlinuz-* /out/kernel && cp /guest/boot/initrd.img-* /out/initrd \
    && mksquashfs /guest /out/guest.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && sha256sum /guest/usr/bin/oblivion-copy > /out/endpoint.sha256 \
    && cd /sources && sha256sum * > /out/sources.sha256 \
    && cd /out && sha256sum * > SHA256SUMS

FROM scratch AS transfer-vm-artifacts
COPY --from=transfer-pack /out/ /

FROM os AS guest
RUN apt-get update && apt-get install -y --no-install-recommends python3 tmux procps sudo \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 oblivion && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /vault/home --shell /bin/sh oblivion \
    && useradd --uid 1001 --gid 1000 --no-create-home --shell /usr/sbin/nologin oblivion-import
RUN passwd -l root && mkdir -p /vault /usr/libexec
COPY --from=compiler /bundle/oblivion-copy /usr/bin/oblivion-copy
COPY packages/oblivion-host/guest/ /usr/lib/oblivion/guest/
RUN sh /usr/lib/oblivion/guest/install.sh

FROM os AS import-guest
COPY --from=compiler /bundle/oblivion-copy /usr/bin/oblivion-copy
COPY packages/oblivion-host/import/ /usr/lib/oblivion/import/
RUN mkdir /source && passwd -l root && chmod 0755 /usr/lib/oblivion/import/*.sh \
    && cp /usr/lib/oblivion/import/oblivion-import-source.service /etc/systemd/system/ \
    && mkdir -p /etc/modules-load.d /etc/udev/rules.d \
    && printf 'virtio_console\nvfat\nexfat\n' > /etc/modules-load.d/oblivion-import.conf \
    && printf '%s\n' 'SUBSYSTEM=="virtio-ports", ATTR{name}=="oblivion.import", OWNER="root", GROUP="root", MODE="0600", TAG+="systemd", ENV{SYSTEMD_WANTS}="oblivion-import-source.service"' > /etc/udev/rules.d/71-oblivion-import.rules

FROM os AS export-guest
COPY --from=compiler /bundle/oblivion-copy /usr/bin/oblivion-copy
COPY packages/oblivion-host/export/ /usr/lib/oblivion/export/
RUN mkdir /target && passwd -l root && chmod 0755 /usr/lib/oblivion/export/*.sh \
    && cp /usr/lib/oblivion/export/oblivion-export-target.service /etc/systemd/system/ \
    && mkdir -p /etc/modules-load.d /etc/udev/rules.d \
    && printf 'virtio_console\nvfat\nexfat\n' > /etc/modules-load.d/oblivion-export.conf \
    && printf '%s\n' 'SUBSYSTEM=="virtio-ports", ATTR{name}=="oblivion.export", OWNER="root", GROUP="root", MODE="0600", TAG+="systemd", ENV{SYSTEMD_WANTS}="oblivion-export-target.service"' > /etc/udev/rules.d/72-oblivion-export.rules

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS session-node
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/install-session-node.py script/oblivion/session-node.json /build/
RUN python3 -B /build/install-session-node.py "$TARGETARCH" /build/session-node.json /node

# Development-only lock generation. Runtime builds consume the reviewed lock;
# users never resolve or install Python dependencies when opening a transfer.
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onionshare-lock-builder
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /resolver \
    && /resolver/bin/pip install --no-cache-dir pip-tools==7.6.2
COPY script/oblivion/onionshare-source.json /source.json
RUN mkdir /out \
    && python3 -c 'import json; p=json.load(open("/source.json")); open("/requirements.in","w").write(p["package"]+"=="+p["version"]+"\n")' \
    && /resolver/bin/pip-compile --generate-hashes --allow-unsafe --strip-extras \
        --pip-args='--only-binary=:all: --no-binary=stem' --output-file=/out/onionshare-requirements.lock /requirements.in

FROM scratch AS onionshare-lock-artifacts
COPY --from=onionshare-lock-builder /out/ /

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onionshare-dependencies
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/install-onionshare.py script/oblivion/onionshare-source.json script/oblivion/onionshare-requirements.lock script/oblivion/onionshare-licenses.json /build/
RUN python3 -B /build/install-onionshare.py /build/onionshare-requirements.lock /build/onionshare-source.json /opt/oblivion-onionshare

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onionshare-runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=onionshare-dependencies /opt/oblivion-onionshare/ /opt/oblivion-onionshare/
COPY packages/oblivion-onion/ /usr/lib/oblivion/onion/

FROM onionshare-runtime AS onionshare-test
RUN groupadd --gid 1000 oblivion && useradd --uid 1000 --gid 1000 --no-create-home oblivion \
    && mkdir -m 0700 /fixture-persistent && chown 1000:1000 /fixture-persistent \
    && printf 'preserve me\n' > /fixture-persistent/canary
COPY script/oblivion/test-onionshare.py /usr/lib/oblivion/test-onionshare.py
USER 1000:1000
ENTRYPOINT ["/usr/bin/python3", "-B", "/usr/lib/oblivion/test-onionshare.py"]

FROM os AS onion-file-base
RUN apt-get update && apt-get install -y --no-install-recommends python3 socat nftables iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=onionshare-dependencies /opt/oblivion-onionshare/ /opt/oblivion-onionshare/
COPY packages/oblivion-onion/service.py packages/oblivion-onion/LICENSE packages/oblivion-onion/NOTICE /usr/lib/oblivion/onion/
COPY packages/oblivion-onion/guest/ /usr/lib/oblivion/onion/guest/
FROM onion-file-base AS onion-file-system
ARG ONION_TRANSFER_BUNDLE=artifacts/ci/transfer
COPY ${ONION_TRANSFER_BUNDLE}/oblivion-copy ${ONION_TRANSFER_BUNDLE}/oblivion-onion-file /usr/bin/
RUN sh /usr/lib/oblivion/onion/guest/install.sh

FROM onion-file-base AS live-onion-file
COPY --from=compiler /bundle/oblivion-copy /bundle/oblivion-onion-file /usr/bin/
RUN sh /usr/lib/oblivion/onion/guest/install.sh

FROM onion-file-system AS onion-file-lab
COPY script/oblivion/vm-onion-file-fixture.py /usr/libexec/oblivion-onion-file-fixture
RUN printf '[Unit]\nRequires=oblivion-onion-file.target\nAfter=oblivion-onion-file.target\n[Service]\nExecStart=/usr/bin/python3 -B /usr/libexec/oblivion-onion-file-fixture file\nStandardInput=tty\nStandardOutput=tty\nStandardError=tty\nTTYPath=/dev/console\nTTYReset=yes\nLimitCORE=0\nExecStopPost=/usr/bin/systemctl --no-block poweroff\n' > /etc/systemd/system/oblivion-onion-file-lab.service \
    && printf '[Unit]\nRequires=oblivion-onion-file-lab.service\nAfter=oblivion-onion-file-lab.service\nAllowIsolate=yes\n' > /etc/systemd/system/oblivion-onion-file-lab.target

FROM os AS onion-file-peer
RUN apt-get update && apt-get install -y --no-install-recommends python3 iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && printf 'virtio_net\n' >> /etc/initramfs-tools/modules && update-initramfs -u -k all
COPY script/oblivion/vm-onion-file-fixture.py /usr/libexec/oblivion-onion-file-fixture
RUN printf '[Unit]\nAfter=multi-user.target\n[Service]\nExecStartPre=/sbin/modprobe virtio_net\nExecStartPre=/usr/bin/udevadm settle\nExecStart=/usr/bin/python3 -B /usr/libexec/oblivion-onion-file-fixture peer\nStandardInput=tty\nStandardOutput=tty\nStandardError=tty\nTTYPath=/dev/console\nTTYReset=yes\nLimitCORE=0\nExecStopPost=/usr/bin/systemctl --no-block poweroff\n' > /etc/systemd/system/oblivion-onion-file-peer.service \
    && printf '[Unit]\nRequires=multi-user.target oblivion-onion-file-peer.service\nAfter=multi-user.target oblivion-onion-file-peer.service\nAllowIsolate=yes\n' > /etc/systemd/system/oblivion-onion-file-peer.target

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onion-file-pack
ARG ONION_TRANSFER_BUNDLE=artifacts/ci/transfer
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools \
    && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-onion/ /sources/onion/
COPY packages/oblivion-transfer/ /sources/transfer/
COPY ${ONION_TRANSFER_BUNDLE}/sources.sha256 /sources/transfer-sources.sha256
COPY script/oblivion/vm-onion-file-fixture.py script/oblivion/run-onion-file-lab.py script/oblivion/Dockerfile.vm-lab script/oblivion/vm-common-setup.sh script/oblivion/onionshare-*.json script/oblivion/onionshare-requirements.lock /sources/lab/
RUN cd /sources/transfer && sha256sum -c /sources/transfer-sources.sha256
RUN --mount=type=bind,from=onion-file-system,source=/,target=/file,ro \
    --mount=type=bind,from=onion-file-lab,source=/,target=/lab,ro \
    --mount=type=bind,from=onion-file-peer,source=/,target=/peer,ro \
    mkdir /out && cp /file/boot/vmlinuz-* /out/kernel && cp /file/boot/initrd.img-* /out/initrd \
    && cp /peer/boot/initrd.img-* /out/peer-initrd \
    && mksquashfs /file /out/file.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && mksquashfs /lab /out/laboratory.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && mksquashfs /peer /out/peer.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && chroot /file dpkg-query -W -f='${Package}\t${Version}\n' > /out/packages.tsv \
    && sha256sum /file/usr/bin/oblivion-onion-file /file/usr/bin/oblivion-copy /file/usr/lib/oblivion/onion/service.py > /out/binaries.sha256 \
    && cp /file/opt/oblivion-onionshare/inventory.json /out/python-inventory.json \
    && cd /sources && find . -type f -print0 | sort -z | xargs -0 sha256sum > /out/sources.sha256 \
    && cd /out && sha256sum * > SHA256SUMS

FROM scratch AS onion-file-artifacts
COPY --from=onion-file-pack /out/ /

# Resolve only when updating the checked-in lock, never when opening a session.
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS session-analysis-lock-builder
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* && python3 -m venv /resolver \
    && /resolver/bin/pip install --no-cache-dir pip-tools==7.6.2
COPY script/oblivion/session-analysis.in /requirements.in
RUN mkdir /out && /resolver/bin/pip-compile --generate-hashes --allow-unsafe --strip-extras \
    --pip-args='--only-binary=:all: --no-binary=ropper,filebytes,mulpyplexer,arpy' \
    --output-file=/out/session-analysis.lock /requirements.in

FROM scratch AS session-analysis-lock-artifacts
COPY --from=session-analysis-lock-builder /out/ /

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS session-analysis
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/install-session-analysis.py script/oblivion/session-analysis.lock script/oblivion/session-analysis-licenses.json /build/
RUN python3 -B /build/install-session-analysis.py /build/session-analysis.lock /opt/oblivion-analysis
RUN printf '[update]\ninterval=never\n' > /etc/pwn.conf

FROM guest AS session-tools
COPY --from=session-analysis /opt/oblivion-analysis/ /opt/oblivion-analysis/
COPY --from=session-analysis /etc/pwn.conf /etc/pwn.conf
COPY --from=session-analysis /usr/local/lib/python3.13/dist-packages/oblivion-analysis.pth /usr/local/lib/python3.13/dist-packages/oblivion-analysis.pth
COPY script/oblivion/session-packages.txt /usr/lib/oblivion/session-packages.txt
COPY script/oblivion/session-node.json /usr/lib/oblivion/session-node.json
COPY --from=session-node /node/ /usr/lib/oblivion/node/
RUN apt-get update && apt-get install -y --no-install-recommends $(cat /usr/lib/oblivion/session-packages.txt) \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/oblivion/node/bin/node /usr/local/bin/node \
    && ln -s /usr/lib/oblivion/node/bin/npm /usr/local/bin/npm \
    && ln -s /usr/lib/oblivion/node/bin/npx /usr/local/bin/npx \
    && ln -s /opt/oblivion-analysis/bin/pwn /usr/local/bin/pwn \
    && ln -s /opt/oblivion-analysis/bin/ropper /usr/local/bin/ropper \
    && python3 -B /usr/lib/oblivion/guest/session-tools.py --build \
    && ln -s /usr/lib/oblivion/guest/session-tools.py /usr/bin/oblivion-tools \
    && chmod 0755 /usr/lib/oblivion/guest/session-tools.py
COPY packages/oblivion-host/guest/gdbinit /etc/gdb/gdbinit

# Fast analysis qualification uses the same locked bundle and Debian package list.
FROM session-analysis AS session-analysis-test
COPY script/oblivion/session-packages.txt /build/session-packages.txt
RUN apt-get update && apt-get install -y --no-install-recommends $(cat /build/session-packages.txt) \
    && rm -rf /var/lib/apt/lists/* && groupadd --gid 1000 oblivion \
    && useradd --uid 1000 --gid 1000 --no-create-home oblivion
COPY packages/oblivion-host/guest/gdbinit /etc/gdb/gdbinit
COPY packages/oblivion-host/guest/session-environment.sh /usr/lib/oblivion/guest/session-environment.sh
COPY script/oblivion/test-session-tools.py /usr/lib/oblivion/test-session-tools.py
USER 1000:1000
ENTRYPOINT ["/usr/bin/python3", "-B", "/usr/lib/oblivion/test-session-tools.py", "SessionToolsTest.test_binary_analysis", "SessionToolsTest.test_python_analysis", "SessionToolsTest.test_debugger_configuration", "SessionToolsTest.test_debuggers"]

FROM session-tools AS session-tools-test
COPY --from=stream-tls-fixture --chown=1000:1000 /fixture/ /fixture/
COPY script/oblivion/test-session-tools.py /usr/lib/oblivion/test-session-tools.py
USER 1000:1000
ENTRYPOINT ["/usr/bin/python3", "-B", "/usr/lib/oblivion/test-session-tools.py"]

FROM rust-toolchain AS gateway-compiler
WORKDIR /gateway
ENV CARGO_TARGET_DIR=/tmp/target
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-tor-state/ /oblivion-tor-state/
COPY packages/oblivion-transport/ /oblivion-transport/
COPY packages/oblivion-gateway/Cargo.toml packages/oblivion-gateway/Cargo.lock ./
COPY packages/oblivion-gateway/.cargo/ .cargo/
RUN cargo fetch --locked
COPY packages/oblivion-gateway/src/ src/
COPY packages/oblivion-gateway/examples/ examples/
COPY packages/oblivion-gateway/guest/firewall.nft guest/firewall.nft
COPY packages/oblivion-gateway/guest/onion/ guest/onion/
COPY packages/oblivion-gateway/tests/ tests/
COPY script/oblivion/test-host-firewall.py script/oblivion/host-firewall.nft /gateway/
RUN --network=none cargo test --locked --offline --lib --features lab-emulation \
    && cargo test --locked --offline --features lab-emulation --bin oblivion-gateway-control --bin oblivion-onion-gateway \
    && cargo test --locked --offline --no-run --features lab-emulation \
    && mkdir /gateway-bundle && cp test-host-firewall.py host-firewall.nft /gateway-bundle/ \
    && cp /tmp/target/debug/oblivion-egress /gateway-bundle/oblivion-egress-lab \
    && cp /tmp/target/debug/oblivion-tools /gateway-bundle/oblivion-tools-lab \
    && cp /tmp/target/debug/oblivion-web /gateway-bundle/oblivion-web-lab \
    && cp /tmp/target/debug/oblivion-rotation /gateway-bundle/oblivion-rotation-lab \
    && cp $(find /tmp/target/debug/deps -type f -name 'oblivion_gateway-*' -executable) /gateway-bundle/gateway-tests \
    && cp $(find /tmp/target/debug/deps -type f -name 'activation-*' -executable) /gateway-bundle/activation-tests \
    && cargo build --locked --offline --bins \
    && cp /tmp/target/debug/oblivion-gateway-control /gateway-bundle/oblivion-gateway-control \
    && cp /tmp/target/debug/oblivion-egress /gateway-bundle/oblivion-egress \
    && cp /tmp/target/debug/oblivion-tools /gateway-bundle/oblivion-tools \
    && cp /tmp/target/debug/oblivion-web /gateway-bundle/oblivion-web \
    && cp /tmp/target/debug/oblivion-rotation /gateway-bundle/oblivion-rotation \
    && cp /tmp/target/debug/oblivion-onion-gateway /gateway-bundle/oblivion-onion-gateway \
    && strip /gateway-bundle/oblivion-* /gateway-bundle/*-tests \
    && find Cargo.toml Cargo.lock .cargo src tests examples guest/firewall.nft guest/onion test-host-firewall.py host-firewall.nft ../oblivion-tor-state/Cargo.toml ../oblivion-tor-state/src ../oblivion-transport/Cargo.toml ../oblivion-transport/src -type f -print0 | sort -z | xargs -0 sha256sum > /gateway-bundle/sources.sha256 \
    && rustc --version > /gateway-bundle/compiler.txt \
    && cd /gateway-bundle && sha256sum * > SHA256SUMS

FROM scratch AS gateway-artifacts
COPY --from=gateway-compiler /gateway-bundle/ /

# Component-only proof of ephemeral onion ownership against the real daemon.
# DisableNetwork remains set; no public Tor service or model request is made.
FROM gateway-compiler AS onion-tor-compiler
RUN --network=none cargo build --locked --offline --features lab-emulation --example onion-probe \
    && strip /tmp/target/debug/examples/onion-probe

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onion-tor-test
RUN apt-get update && apt-get install -y --no-install-recommends python3 tor openssl util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupmod -g 1200 debian-tor && usermod -u 1200 -g 1200 debian-tor
COPY --from=onion-tor-compiler /tmp/target/debug/examples/onion-probe /usr/bin/oblivion-onion-probe
COPY packages/oblivion-gateway/guest/onion/torrc /etc/oblivion/onion/torrc
COPY script/oblivion/test-onion-tor.py /usr/lib/oblivion/test-onion-tor.py
ENTRYPOINT ["/usr/bin/python3", "-B", "/usr/lib/oblivion/test-onion-tor.py"]

FROM os AS gateway-system
RUN apt-get update && apt-get install -y --no-install-recommends tor nftables iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-gateway/guest/ /gateway-config/
COPY --from=gateway-compiler /gateway-bundle/oblivion-gateway-control /usr/bin/oblivion-gateway-control
COPY --from=gateway-compiler /gateway-bundle/oblivion-egress /usr/bin/oblivion-egress
COPY --from=gateway-compiler /gateway-bundle/oblivion-tools /usr/bin/oblivion-tools
COPY --from=gateway-compiler /gateway-bundle/oblivion-web /usr/bin/oblivion-web
COPY --from=gateway-compiler /gateway-bundle/oblivion-rotation /usr/bin/oblivion-rotation
COPY packages/oblivion-tor-state/src/lib.rs /tmp/oblivion-tor-state.rs
RUN expected="$(sed -n 's/^pub const VERSION: &str = "\([^"]*\)";$/\1/p' /tmp/oblivion-tor-state.rs)" \
    && actual="$(tor --version | sed -n '1s/^Tor version \([0-9.]*\)\.$/\1/p')" \
    && test -n "$expected" && test "$actual" = "$expected" \
    && rm /tmp/oblivion-tor-state.rs \
    && sh /gateway-config/install.sh && rm -rf /gateway-config
# BuildKit mounts its own resolver read-only during RUN; COPY replaces the
# image's file without touching that build-time mount.
COPY packages/oblivion-gateway/guest/resolv.conf /etc/resolv.conf

FROM gateway-system AS onion-gateway-system
COPY --from=gateway-compiler /gateway-bundle/oblivion-onion-gateway /usr/bin/oblivion-onion-gateway
COPY packages/oblivion-gateway/guest/onion/ /onion-config/
RUN sh /onion-config/install.sh && rm -rf /onion-config

FROM onion-gateway-system AS onion-control-lab
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/vm-onion-fixture.py /usr/libexec/oblivion-onion-fixture
RUN printf '[Unit]\nRequires=oblivion-onion-gateway.target\nAfter=oblivion-onion-gateway.target\n[Service]\nType=simple\nExecStart=/usr/bin/python3 -B /usr/libexec/oblivion-onion-fixture\nStandardInput=tty\nStandardOutput=tty\nStandardError=tty\nTTYPath=/dev/console\nTTYReset=yes\nLimitCORE=0\nExecStopPost=/usr/bin/systemctl --no-block poweroff\n' > /etc/systemd/system/oblivion-onion-lab.service \
    && printf '[Unit]\nRequires=oblivion-onion-lab.service\nAfter=oblivion-onion-lab.service\nAllowIsolate=yes\n' > /etc/systemd/system/oblivion-onion-lab.target

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onion-control-pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools \
    && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-gateway/guest/ /sources/guest/
COPY script/oblivion/vm-onion-fixture.py script/oblivion/run-onion-lab.py /sources/lab/
COPY --from=gateway-compiler /gateway-bundle/sources.sha256 /sources/compiler.sha256
RUN --mount=type=bind,from=onion-gateway-system,source=/,target=/gateway,ro \
    --mount=type=bind,from=onion-control-lab,source=/,target=/lab,ro \
    mkdir /out && cp /gateway/boot/vmlinuz-* /out/kernel && cp /gateway/boot/initrd.img-* /out/initrd \
    && mksquashfs /gateway /out/gateway.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && mksquashfs /lab /out/laboratory.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && chroot /gateway dpkg-query -W -f='${Package}\t${Version}\n' > /out/packages.tsv \
    && sha256sum /gateway/usr/bin/oblivion-onion-gateway > /out/controller.sha256 \
    && cd /sources && find . -type f -print0 | sort -z | xargs -0 sha256sum > /out/sources.sha256 \
    && cd /out && sha256sum * > SHA256SUMS

FROM scratch AS onion-control-artifacts
COPY --from=onion-control-pack /out/ /

# Independent public caller for the explicit online integration laboratory.
# It is never copied into the Live image or an Oblivion guest.
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onion-recipient-test
RUN apt-get update && apt-get install -y --no-install-recommends python3 tor curl openssl \
    && rm -rf /var/lib/apt/lists/* && touch /etc/oblivion-recipient.torrc
COPY script/oblivion/vm-onion-recipient.py /usr/lib/oblivion/vm-onion-recipient.py
USER 1000:1000
ENTRYPOINT ["/usr/bin/python3", "-B", "/usr/lib/oblivion/vm-onion-recipient.py"]

# Private Debian controller; never installed as the outer Live OS.
FROM nested-hypervisor-os AS controller-host
ARG TARGETARCH
ARG MANAGER_BINARY=artifacts/oblivion-manager/bun-linux-x64/oblivion-manager
ARG MANAGER_ASSETS=artifacts/oblivion-manager/bun-linux-x64/assets
RUN case "$TARGETARCH" in arm64|amd64) ;; *) exit 1;; esac \
    && sed -i 's/^Components: main$/Components: main non-free-firmware/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    live-boot live-boot-initramfs-tools cryptsetup-bin dmsetup fdisk \
    $(if [ "$TARGETARCH" = arm64 ]; then printf qemu-system-arm; else printf qemu-system-x86; fi) \
    python3 network-manager wpasupplicant iproute2 nftables console-setup-mini kbd tzdata xkb-data \
    firmware-iwlwifi firmware-realtek firmware-atheros firmware-brcm80211 firmware-mediatek \
    && rm -rf /var/lib/apt/lists/*
COPY --from=compiler /bundle/oblivion-storage /bundle/oblivion-control /bundle/oblivion-copy /usr/bin/
COPY ${MANAGER_BINARY} /usr/bin/oblivion-manager
COPY ${MANAGER_ASSETS} /usr/lib/oblivion/manager/
COPY packages/oblivion-host/host/*.service /etc/systemd/system/
COPY packages/oblivion-host/host/control-relay.py /usr/lib/oblivion/control-relay.py
COPY packages/oblivion-host/host/runtime-prepare.py /usr/lib/oblivion/host/runtime-prepare.py
COPY packages/oblivion-host/host/runtime-auth.py /usr/lib/oblivion/host/runtime-auth.py
COPY packages/oblivion-host/host/runtime-network.py /usr/lib/oblivion/host/runtime-network.py
COPY packages/oblivion-host/host/oblivion-runtime-generator /usr/lib/systemd/system-generators/oblivion-runtime-generator
COPY script/oblivion/controller-setup.sh /tmp/live-setup
COPY script/oblivion/hypervisor-kernel.py /tmp/hypervisor-kernel.py
COPY script/oblivion/session-identities.sh /tmp/session-identities
COPY script/oblivion/live-controller.json /etc/oblivion/controller.json
COPY script/oblivion/host-firewall.nft /etc/oblivion/host-firewall.nft
COPY packages/oblivion-gateway/guest/resolv.conf /etc/resolv.conf
RUN sh /tmp/live-setup && sh /tmp/session-identities && rm /tmp/live-setup /tmp/session-identities /tmp/hypervisor-kernel.py

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS live-pack-tools
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
    squashfs-tools $(if [ "$TARGETARCH" = arm64 ]; then printf grub-efi-arm64-bin; else printf 'grub-pc-bin grub-efi-amd64-bin'; fi) grub-common xorriso mtools python3 initramfs-tools-core \
    && rm -rf /var/lib/apt/lists/*
FROM session-tools AS stack-session
ARG TARGETARCH
ARG OBLIVION_AGENTS="codex claude opencode2"
COPY packages/oblivion-history/prepare.py /usr/lib/oblivion/history/prepare.py
COPY packages/oblivion-history/oblivion_history/ /usr/lib/oblivion/history/oblivion_history/
COPY packages/oblivion-tools/dist/server.mjs /usr/lib/oblivion/tools/server.mjs
COPY packages/oblivion-host/guest/native-tools/codex.toml /etc/codex/config.toml
COPY script/oblivion/install-agents.py script/oblivion/install-agents.json /build/agents/
COPY script/oblivion/agent-notices/ /build/agents/agent-notices/
RUN python3 /build/agents/install-agents.py "$TARGETARCH" / $OBLIVION_AGENTS --verify \
    && rm -rf /build/agents
COPY packages/oblivion-host/guest/hostname packages/oblivion-host/guest/hosts /etc/

# Direct-controller Debian packaging deliberately excludes Live OS configuration.
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS debian-runtime-source
ARG TARGETARCH
ARG MANAGER_BINARY=artifacts/oblivion-manager/bun-linux-x64/oblivion-manager
ARG MANAGER_ASSETS=artifacts/oblivion-manager/bun-linux-x64/assets
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd python3 cryptsetup-bin dmsetup e2fsprogs util-linux mount fdisk udev debconf \
    $(if [ "$TARGETARCH" = arm64 ]; then printf qemu-system-arm; else printf qemu-system-x86; fi) \
    && rm -rf /var/lib/apt/lists/*
COPY --from=compiler /bundle/oblivion /bundle/oblivion-storage /bundle/oblivion-control /bundle/oblivion-copy /usr/bin/
COPY ${MANAGER_BINARY} /usr/bin/oblivion-manager
COPY ${MANAGER_ASSETS} /usr/lib/oblivion/manager/
COPY packages/oblivion-host/host/*.service /etc/systemd/system/
COPY script/oblivion/live-controller.json /etc/oblivion/controller.json
COPY LICENSE NOTICE /usr/share/doc/oblivion-stack/

FROM debian-runtime-source AS debian-package-build
ARG TARGETARCH
ARG OBLIVION_DEB_VERSION
ARG OBLIVION_SOURCE_REVISION
ARG OBLIVION_SOURCE_DIRTY
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools dpkg-dev libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=stack-session / /roles/session/
COPY --from=gateway-system / /roles/gateway/
COPY --from=import-guest / /roles/import/
COPY --from=export-guest / /roles/export/
COPY --from=onion-gateway-system / /roles/onion-gateway/
COPY --from=live-onion-file / /roles/onion-file/
COPY --from=compiler /bundle/sources.sha256 /usr/share/doc/oblivion-stack/build/host-sources.sha256
COPY --from=gateway-compiler /gateway-bundle/sources.sha256 /usr/share/doc/oblivion-stack/build/gateway-sources.sha256
COPY script/oblivion/pack-vm-assets.sh /pack-vm-assets.sh
COPY script/oblivion/debian/ /packaging/
COPY script/oblivion/build-deb.sh script/oblivion/Dockerfile.vm-lab script/oblivion/Dockerfile.vm-lab.dockerignore /packaging-build-inputs/
COPY packages/oblivion-host/guest/ /packaging-runtime-inputs/safe-guest/
COPY packages/oblivion-history/oblivion_history/ /packaging-runtime-inputs/history/
COPY packages/oblivion-tools/dist/server.mjs /packaging-runtime-inputs/tools/server.mjs
COPY packages/oblivion-manager/src/ /packaging-runtime-inputs/manager/src/
COPY packages/oblivion-manager/script/build.ts packages/oblivion-manager/package.json /packaging-runtime-inputs/manager/
COPY packages/theme/src/ /packaging-runtime-inputs/theme/
COPY packages/tui-kit/src/ /packaging-runtime-inputs/tui-kit/
COPY package.json bun.lock /packaging-runtime-inputs/workspace/
COPY script/oblivion/install-agents.py script/oblivion/install-agents.json script/oblivion/session-node.json script/oblivion/install-session-node.py script/oblivion/session-packages.txt script/oblivion/session-analysis.lock script/oblivion/session-analysis-licenses.json script/oblivion/install-session-analysis.py script/oblivion/onionshare-source.json script/oblivion/onionshare-requirements.lock script/oblivion/install-onionshare.py /packaging-runtime-inputs/locks/
COPY script/oblivion/agent-notices/ /packaging-runtime-inputs/locks/agent-notices/
RUN sh /pack-vm-assets.sh / /roles /usr/share/doc/oblivion-stack/build \
    && cp /roles/session/usr/lib/oblivion/build-evidence.json /usr/share/doc/oblivion-stack/build/client-evidence.json \
    && python3 -c 'import json,os,pathlib; pathlib.Path("/usr/share/doc/oblivion-stack/build/inputs.json").write_text(json.dumps({"format":"oblivion-debian-build","version":1,"revision":os.environ["OBLIVION_SOURCE_REVISION"],"dirty":os.environ["OBLIVION_SOURCE_DIRTY"]=="true","architecture":os.environ["TARGETARCH"],"development_only":True})+"\n")' \
    && sha256sum /packaging/* /packaging-build-inputs/* /pack-vm-assets.sh > /usr/share/doc/oblivion-stack/build/packaging-sources.sha256 \
    && (cd /packaging-runtime-inputs && find . -type f -print0 | sort -z | xargs -0 sha256sum) > /usr/share/doc/oblivion-stack/build/runtime-sources.sha256 \
    && python3 -B /packaging/build-package.py --source / --architecture "$TARGETARCH" --version "$OBLIVION_DEB_VERSION" --output /out

FROM scratch AS debian-package-artifacts
COPY --from=debian-package-build /out/ /

FROM live-pack-tools AS stack-pack
ARG OBLIVION_IMAGE_NAME=oblivion-stack-development
COPY --from=controller-host / /host/
COPY --from=stack-session / /session/
COPY --from=gateway-system / /gateway/
COPY --from=import-guest / /import/
COPY --from=export-guest / /export/
COPY --from=onion-gateway-system / /onion-gateway/
COPY --from=live-onion-file / /onion-file/
COPY --from=compiler /bundle/sources.sha256 /sources/host-sources.sha256
COPY --from=gateway-compiler /gateway-bundle/sources.sha256 /sources/gateway-sources.sha256
COPY script/oblivion/hypervisor-kernel.py script/oblivion/controller-* script/oblivion/live-* script/oblivion/pack-vm-assets.sh script/oblivion/vm-common-setup.sh script/oblivion/journald-forwarding.conf script/oblivion/Dockerfile.vm-lab /sources/
RUN OBLIVION_IMAGE_NAME="$OBLIVION_IMAGE_NAME" sh /sources/controller-pack.sh

FROM scratch AS controller-runtime-artifacts
COPY --from=stack-pack /out/ /


# Compile the external Linux launcher against exactly the controller source
# inventory above, then assemble the same bundle used by Linux desktop installs.
FROM compiler AS live-native-build
ARG TARGETARCH
ARG OBLIVION_DESKTOP_VERSION=1.0.0~dev
ARG MANAGER_BINARY=artifacts/oblivion-manager/bun-linux-x64/oblivion-manager
ARG MANAGER_ASSETS=artifacts/oblivion-manager/bun-linux-x64/assets
ARG MANAGER_LICENSES=artifacts/oblivion-manager/bun-linux-x64/licenses
COPY --from=stack-pack /out/ /runtime-output/
COPY packages/oblivion-native-linux/ /native-helper/
COPY script/oblivion/bundle-native.py /script/oblivion/bundle-native.py
COPY --from=compiler /runtime-inputs/ /script/oblivion/
COPY docs/DESKTOP.md /docs/DESKTOP.md
COPY script/oblivion/desktop/install.sh /script/oblivion/desktop/install.sh
COPY ${MANAGER_BINARY} /native-manager/oblivion-manager
COPY ${MANAGER_ASSETS} /native-manager/assets/
COPY ${MANAGER_LICENSES} /oblivion-manager/node_modules/
RUN apt-get update && apt-get install -y --no-install-recommends libarchive-tools && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /packages \
    && ln -s /build /packages/oblivion-host \
    && for package in oblivion-cli oblivion-bundle oblivion-native-windows oblivion-wire oblivion-transfer oblivion-share oblivion-tor-state oblivion-transport oblivion-history oblivion-tools oblivion-gateway oblivion-onion oblivion-clipboard oblivion-manager theme tui-kit; do ln -s "/$package" "/packages/$package"; done \
    && cp /workspace-inputs/* / \
    && case "$TARGETARCH" in amd64) platform=linux-x86_64;; arm64) platform=linux-arm64;; *) exit 1;; esac \
    && identity=$(python3 -B /script/oblivion/bundle-native.py prepare --runtime /runtime-output --platform "$platform" --output /prepared) \
    && OBLIVION_DESKTOP_VERSION="$OBLIVION_DESKTOP_VERSION" OBLIVION_DESKTOP_SOURCE_SHA256="$identity" OBLIVION_DESKTOP_PLATFORM="$platform" cargo build --locked --release --bin oblivion \
    && cargo build --manifest-path /native-helper/Cargo.toml --locked --release \
    && python3 -B /script/oblivion/bundle-native.py assemble --prepared /prepared --platform "$platform" --product-version "$OBLIVION_DESKTOP_VERSION" --cli /build/target/release/oblivion --helper /native-helper/target/release/oblivion-vm --manager /native-manager/oblivion-manager --manager-assets /native-manager/assets --output /desktop

FROM live-native-build AS desktop-debian-build
ARG OBLIVION_SOURCE_REVISION
ARG OBLIVION_SOURCE_DIRTY
COPY script/oblivion/desktop/build-package.py script/oblivion/desktop/oblivion-desktop.conf script/oblivion/desktop/org.oblivion.desktop.policy script/oblivion/desktop/postinst /package-inputs/script/oblivion/desktop/
COPY script/oblivion/build-desktop-deb.sh script/oblivion/Dockerfile.vm-lab script/oblivion/Dockerfile.vm-lab.dockerignore /package-inputs/script/oblivion/
RUN apt-get update && apt-get install -y --no-install-recommends dpkg-dev libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /package-inputs/packages/oblivion-native-linux \
    && cp -a /native-helper/Cargo.toml /native-helper/Cargo.lock /native-helper/src /package-inputs/packages/oblivion-native-linux/ \
    && cp /script/oblivion/bundle-native.py /package-inputs/script/oblivion/ \
    && python3 -B /package-inputs/script/oblivion/desktop/build-package.py --source /desktop --architecture "$TARGETARCH" --version "$OBLIVION_DESKTOP_VERSION" --revision "$OBLIVION_SOURCE_REVISION" --dirty "$OBLIVION_SOURCE_DIRTY" --output /out

FROM scratch AS desktop-debian-artifacts
COPY --from=desktop-debian-build /out/ /

FROM nested-hypervisor-os AS live-launcher
ARG TARGETARCH
COPY script/oblivion/hypervisor-qemu.py /tmp/hypervisor-qemu.py
RUN sed -i 's/^Components: main$/Components: main non-free-firmware/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    live-boot live-boot-initramfs-tools python3 fdisk sudo network-manager wpasupplicant \
    libwlroots-0.18 foot seatd fonts-dejavu-mono libxkbcommon-tools libpciaccess0 \
    console-setup-mini kbd tzdata xkb-data whiptail \
    firmware-iwlwifi firmware-realtek firmware-atheros firmware-brcm80211 firmware-mediatek \
    && python3 -B /tmp/hypervisor-qemu.py install "$TARGETARCH" \
    && rm /tmp/hypervisor-qemu.py \
    && rm -rf /var/lib/apt/lists/*
COPY --from=live-native-build /desktop/ /usr/lib/oblivion/desktop/
COPY --from=compiler /bundle/oblivion-display /usr/bin/
COPY --from=cage-build /out/oblivion-cage /usr/bin/
COPY --from=cage-build /out/LICENSE /out/oblivion.patch /out/cage-source.sha256 /usr/share/doc/oblivion-display/
COPY --from=clipboard-compiler /clipboard/target/release/oblivion-clipboard /usr/bin/
COPY --from=clipboard-compiler /clipboard/LICENSE /clipboard/PROVENANCE.md /clipboard/upstream.json /clipboard/Cargo.lock /clipboard/sources.sha256 /usr/share/doc/oblivion-clipboard/
COPY --from=clipboard-broker /out/usr/sbin/spice-vdagentd /usr/sbin/
COPY --from=clipboard-broker /out/usr/share/doc/spice-vdagent/ /usr/share/doc/spice-vdagent/
COPY --from=clipboard-broker /out/package.control /out/SHA256SUMS /usr/share/doc/spice-vdagent/
COPY --from=vbox-clipboard /out/ /usr/lib/oblivion/virtualbox/
COPY script/oblivion/live-storage.py script/oblivion/live-media.py /usr/lib/oblivion/
COPY script/oblivion/live-os/ /usr/lib/oblivion/live-os/
COPY script/oblivion/live-setup.sh /tmp/live-setup
RUN chmod 0755 /usr/lib/oblivion/live-storage.py /usr/lib/oblivion/live-media.py && sh /tmp/live-setup && rm /tmp/live-setup \
    && ln -s /usr/lib/oblivion/desktop/bin/oblivion /usr/bin/oblivion
COPY script/oblivion/display/*.service script/oblivion/display/*.socket script/oblivion/display/manager.conf script/oblivion/display/foot.ini script/oblivion/display/start.sh script/oblivion/display/70-oblivion-clipboard.rules /usr/lib/oblivion/display/
COPY script/oblivion/display/install.sh /tmp/display-setup
RUN sh /tmp/display-setup && rm /tmp/display-setup


FROM live-pack-tools AS live-iso-pack
ARG OBLIVION_IMAGE_NAME=oblivion-development
COPY --from=live-launcher / /host/
COPY script/oblivion/live-* script/oblivion/hypervisor-kernel.py script/oblivion/hypervisor-qemu.py /sources/
COPY script/oblivion/live-os/ /sources/live-os/
RUN OBLIVION_IMAGE_NAME="$OBLIVION_IMAGE_NAME" sh /sources/live-pack.sh

FROM scratch AS live-iso-artifacts
COPY --from=live-iso-pack /out/ /
