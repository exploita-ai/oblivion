[Unit]
Description=Oblivion display device broker
After=systemd-udev-trigger.service
Before=oblivion-display.service

[Service]
Type=simple
ExecStart=/usr/sbin/seatd -g oblivion-display -l error
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
DevicePolicy=closed
DeviceAllow=char-drm rw
# libinput opens event devices read/write for keyboard LEDs.
DeviceAllow=char-input rw
DeviceAllow=/dev/tty0 rw
DeviceAllow=/dev/tty1 rw
ReadWritePaths=/run
LimitCORE=0
MemorySwapMax=0
StandardInput=null
StandardOutput=null
StandardError=null
