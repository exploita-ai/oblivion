#!/bin/sh
set -eu
case "$1" in
    install|upgrade)
        if [ -r /proc/swaps ]; then
            active=$(sed '1d' /proc/swaps)
            if [ -n "$active" ]; then
                echo 'Oblivion direct mode requires swap already disabled. Installation never changes host swap.' >&2
                exit 1
            fi
        fi
        ;;
esac
