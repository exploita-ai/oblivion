# The upstream suite runs Node-specific ESM loader probes. Bun's fallback node
# shim is not a substitute for the real Node runtime.
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS node
FROM oblivion-audit:v2.1.4
COPY --from=node /usr/local/bin/node /usr/local/bin/node
