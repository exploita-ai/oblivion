{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".github/actions/setup-bun/**",
    "package.json"
  ],
  "globalEnv": [
    "CI"
  ],
  "globalPassThroughEnv": [
    "CI"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "typecheck:tsc": {
      "dependsOn": [
        "transit"
      ]
    },
    "build": {
      "dependsOn": [
        "transit"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    }
  }
}
